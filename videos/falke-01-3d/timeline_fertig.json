   "datei": null,
   "verschoben": 0.58
  },
  {
   "id": "15_van_6",
   "szene": "van",
   "start": 6.9,
   "ende": 9.522,
   "wer": "6",
   "text": "Sieben, du bist ein Angsthase mit WLAN.",
